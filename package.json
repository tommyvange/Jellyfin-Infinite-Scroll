{
  "name": "jellyfin-infinite-scroll",
  "version": "1.1.0",
  "private": true,
  "description": "Infinite scroll server plugin for Jellyfin Web 12 and newer.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:transformations": "dotnet run --project tests/Transformations",
    "test:registration": "dotnet run --project tests/RegistrationScanner",
    "build": "dotnet build src/Jellyfin.Plugin.InfiniteScroll -c Release",
    "package": "node scripts/package.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "release:info": "node scripts/release-info.mjs"
  },
  "engines": { "node": ">=20" }
}
